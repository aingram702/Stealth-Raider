{
  "manifest_version": 3,
  "name": "Stealth Raider",
  "short_name": "Stealth Raider",
  "version": "1.0.1",
  "description": "Covert browsing kit: spoof your fingerprint, location & IP, run incognito raids, and self-destruct every trace.",
  "author": "Stealth Raider",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Stealth Raider",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "32": "src/assets/icons/icon32.png",
      "48": "src/assets/icons/icon48.png",
      "128": "src/assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/fingerprint-spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/inject-loader.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "proxy",
    "privacy",
    "browsingData",
    "storage",
    "tabs",
    "declarativeNetRequest",
    "webRequest",
    "webRequestAuthProvider",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "incognito": "spanning",
  "commands": {
    "panic": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "PANIC: abort raid, wipe everything, forge new identity"
    },
    "launch-raid": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Launch a stealth raid (incognito)"
    },
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Open Stealth Raider cockpit"
    }
  }
}
